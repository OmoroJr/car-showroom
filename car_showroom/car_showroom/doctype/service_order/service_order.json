   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1,
   "delete": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "print": 1,
   "export": 1,
   "report": 1
  }
 ]
}
