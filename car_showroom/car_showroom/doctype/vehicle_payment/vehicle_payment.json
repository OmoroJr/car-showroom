  },
  {
   "fieldname": "receipt_number",
   "label": "Receipt Number",
   "fieldtype": "Data",
   "read_only": 1
  },
  {
   "fieldname": "received_by",
   "label": "Received By",
   "fieldtype": "Link",
   "options": "User",
   "default": "__user"
  }
