   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "scenario",
   "label": "Scenario",
   "fieldtype": "Select",
   "in_list_view": 1,
   "options": "7 Days Before\nDue Today\n3 Days Overdue\n30+ Days Overdue"
  },
  {
   "fieldname": "channel",
   "label": "Channel",
   "fieldtype": "Select",
