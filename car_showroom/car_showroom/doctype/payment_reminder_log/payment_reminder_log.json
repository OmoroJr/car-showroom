   "options": "Email\nSMS\nWhatsApp"
  },
  {
   "fieldname": "column_break_prl1",
   "label": "",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "recipient",
   "label": "Recipient",
   "fieldtype": "Data"
  },
  {
   "fieldname": "sent_on",
   "label": "Sent On",
   "fieldtype": "Datetime",
   "default": "Now"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "options": "Sent\nFailed",
   "default": "Sent"
  },
  {
   "fieldname": "section_break_prl1",
   "label": "",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "message",
