{
 "doctype": "DocType",
 "name": "Vehicle Lead",
 "module": "Car Showroom",
 "custom": 0,
 "istable": 0,
 "editable_grid": 0,
 "engine": "InnoDB",
 "track_changes": 1,
 "field_order": [
  "naming_series",
  "lead_name",
  "customer",
  "phone",
  "email",
  "column_break_l1",
  "source",
  "branch",
  "salesperson",
  "section_break_l1",
  "interested_vehicle",
  "interested_make",
  "interested_model",
  "budget",
  "section_break_l2",
  "status",
  "lost_reason"
 ],
 "fields": [
  {
   "fieldname": "naming_series",
   "label": "Naming Series",
   "fieldtype": "Select",
   "options": "LEAD-.YYYY.-.#####",
   "default": "LEAD-.YYYY.-.#####"
  },
  {
   "fieldname": "lead_name",
   "label": "Lead Name",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "customer",
   "label": "Linked Customer",
   "fieldtype": "Link",
   "options": "Showroom Customer",
   "description": "Filled in once the lead is qualified / converted"
  },
  {
   "fieldname": "phone",
   "label": "Phone",
   "fieldtype": "Data",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "email",
   "label": "Email",
   "fieldtype": "Data"
  },
  {
   "fieldname": "column_break_l1",
   "label": "",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "source",
   "label": "Lead Source",
   "fieldtype": "Select",
   "options": "Walk-in\nWebsite\nFacebook\nInstagram\nTikTok\nWhatsApp\nJiji\nReferral\nExisting Customer\nDealer Referral"
  },
  {
   "fieldname": "branch",
   "label": "Branch",
   "fieldtype": "Link",
   "options": "Dealership Branch"
  },
  {
   "fieldname": "salesperson",
   "label": "Salesperson",
   "fieldtype": "Link",
   "options": "Salesperson",
   "in_list_view": 1
  },
  {
   "fieldname": "section_break_l1",
   "label": "Interest",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "interested_vehicle",
   "label": "Interested Vehicle",
   "fieldtype": "Link",
   "options": "Vehicle"
  },
  {
   "fieldname": "interested_make",
   "label": "Interested Make",
   "fieldtype": "Data"
  },
  {
   "fieldname": "interested_model",
   "label": "Interested Model",
   "fieldtype": "Data"
  },
  {
   "fieldname": "budget",
   "label": "Budget (KES)",
   "fieldtype": "Currency"
  },
  {
   "fieldname": "section_break_l2",
   "label": "Status",
   "fieldtype": "Section Break"
  },
  {
   "fieldname": "status",
   "label": "Status",
   "fieldtype": "Select",
   "in_list_view": 1,
   "bold": 1,
   "options": "New Lead\nContacted\nQualified\nVehicle Selected\nTest Drive\nNegotiation\nFinancing\nDeposit\nSale\nDelivered\nLost",
   "default": "New Lead"
  },
  {
   "fieldname": "lost_reason",
   "label": "Lost Reason",
   "fieldtype": "Small Text",
   "depends_on": "eval:doc.status=='Lost'"
  }
 ],
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "naming_series:",
 "title_field": "lead_name",
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "Salesperson",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1
  },
  {
   "role": "Sales Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1,
   "delete": 1
  },
  {
   "role": "Marketing Officer",
   "read": 1,
   "write": 1,
   "create": 1,
   "print": 1,
   "email": 1,
   "export": 1,
   "report": 1,
   "share": 1
  }
 ]
}
